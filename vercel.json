{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.mjs": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/read/:path*",
      "destination": "/api/reader?path=:path*"
    }
  ],
  "redirects": [
    {
      "source": "/privacy",
      "destination": "https://legal.tryfermata.app/#privacy",
      "permanent": false
    },
    {
      "source": "/terms",
      "destination": "https://legal.tryfermata.app/#terms",
      "permanent": false
    },
    {
      "source": "/legal",
      "destination": "https://legal.tryfermata.app/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
