{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.mjs": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/read/:path*",
      "destination": "/api/reader?path=:path*"
    }
  ]
}